APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# DevPilot
###############################################################################

# Raízes que o seletor de pastas pode navegar, separadas por vírgula. É o limite
# de segurança: nada fora daqui é listado, e a página de Comandos recusa rodar
# em pasta fora destas raízes.
DEV_ROOTS=C:\laragon\www

# Faixa usada para sugerir a próxima porta livre.
SERVICE_PORT_START=8000
SERVICE_PORT_END=8099

# Host padrão ao sugerir o comando de um projeto detectado.
# 127.0.0.1 = só esta máquina | 0.0.0.0 = todas as interfaces
SERVICE_DEFAULT_HOST=127.0.0.1

# Agente de supervisão
AGENT_INTERVAL=3
AGENT_TASK_NAME=DevPilot-Agent
AGENT_SERVICE_NAME=DevPilotAgent
# Caminho do nssm.exe, se for registrar o agente por NSSM em vez do Agendador.
NSSM_PATH=nssm

# Captura de stdout/stderr para o banco (busca e filtro por nível no painel).
SERVICE_LOGS_INGEST=true
SERVICE_LOGS_MAX_ROWS=5000
SERVICE_LOGS_ROTATE_MB=10
SERVICE_LOGS_RETENTION_DAYS=7

# Health check HTTP
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_FAILURES=3

# Alertas no sino do painel
SERVICE_ALERTS=true
SERVICE_ALERTS_COOLDOWN=10

# Tempo limite dos comandos da página "Comandos", em segundos.
PROJECT_COMMAND_TIMEOUT=300

# Identidade exibida na página inicial pública.
PROJECT_NAME=DevPilot
PROJECT_REPOSITORY=https://github.com/EudesSA/DevPilot
PROJECT_AUTHOR="EudesSA - ProezaTech"
PROJECT_WEBSITE=https://www.proezatech.com
PROJECT_VERSION=1.0.0
